{
  "name": "troy-proxy",
  "version": "0.1.1",
  "description": "Local LLM API proxy with multi-provider routing, combos, cooldowns and a usage dashboard",
  "license": "GPL-3.0-or-later",
  "author": "Muhammad Zaki <tuanzaki9@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzaki9/troy.git"
  },
  "keywords": [
    "llm",
    "proxy",
    "anthropic",
    "openai",
    "api-gateway",
    "opencode",
    "ai"
  ],
  "type": "module",
  "bin": {
    "troy": "bin/troy.js",
    "troy-proxy": "bin/troy.js"
  },
  "files": [
    "bin",
    "src",
    "dashboard",
    "public",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun build dashboard/app.tsx --outdir dashboard/dist --minify --watch & tailwindcss -i dashboard/styles.css -o dashboard/dist/styles.css --minify & bun --smol --watch src/server.ts",
    "start": "bun --smol src/server.ts",
    "build": "NODE_ENV=production bun build dashboard/app.tsx --outdir dashboard/dist --minify && tailwindcss -i dashboard/styles.css -o dashboard/dist/styles.css --minify",
    "lint": "biome check src dashboard test",
    "test": "bun test --parallel",
    "prepublishOnly": "bun test && biome check src && NODE_ENV=production bun run build"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "troy-proxy": "^0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0"
  }
}
